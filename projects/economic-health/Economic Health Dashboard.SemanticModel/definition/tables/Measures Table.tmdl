			FORMAT(
			    MAX('Refresh Date'[RefreshDate]),
			    "MMM dd, YYYY"
			)
			```
		displayFolder: Labels and Dynamic Titles
		lineageTag: 3d2e2345-fb0c-450f-80bd-deb74b7350e1

	measure Quarter =
			
			MAX(
			    'Calendar'[Quarter Year]
			)
		displayFolder: Labels and Dynamic Titles
		lineageTag: 08aafdf8-b016-46c8-a67d-4f8d461b2f24

	measure 'Economic Health Summary' = ```
			
			VAR headlineCPI = 
			FORMAT(
			    CALCULATE(
			        [Latest Value],
			        'Economic Data'[Attribute] = "Headline CPI (YoY)"
			    ),"0.0%"
			)
			VAR coreCPI = 
			FORMAT(
			    CALCULATE(
			        [Latest Value],
			        'Economic Data'[Attribute] = "Core CPI (YoY)"
			    ),"0.0%"
			)
			VAR FoodEnergy = 
			FORMAT(
			    (CALCULATE(
			        [Latest Value],
			        'Economic Data'[Attribute] = "Headline CPI (YoY)"
			    ) - 
			    CALCULATE(
			        [Latest Value],
			        'Economic Data'[Attribute] = "Core CPI (YoY)"
			    ))*100,
			    "0.0"
			)
			VAR GDP = 
			FORMAT(
			    CALCULATE(
			        [Latest Value],
			        'Economic Data'[Attribute] = "Real GDP Growth"
			    ),"0.0%"
			)
			VAR PQGDP = 
			FORMAT(
			    CALCULATE(
			        [Prior Value],
			        'Economic Data'[Attribute] = "Real GDP Growth"
			    ),"0.0%"
			)
			VAR GDPChg = 
			ROUND(
			    CALCULATE(
			        [Chg vs Prior Value],
			        'Attribute Sorting Table'[Attribute] = "Real GDP Growth"
			    ),
			    3
			)
			VAR GDPUpDown = 
			SWITCH(
			    TRUE(),
			    GDPChg > 0, ", an increase",
			    gdpchg < 0, ", a decrease",
			    ", flat"
			)
			VAR QuarterName = 
			LOOKUPVALUE(
			    'Calendar'[Quarter Year],
			    'Calendar'[Date],
			    CALCULATE(
			        MAX('Economic Data'[date]),
			        'Economic Data'[Attribute] = "Real GDP Growth"
			    )
			)
			VAR FedRate = 
			CALCULATE(
			    [Chg vs Prior Value],
			    'Economic Data'[Attribute] = "Fed Funds Rate"
			)
			VAR FedRateForamtted = 
			FORMAT(
			    FedRate,
			    "0.00%"
			)
			VAR Unemployment = 
			ROUND(
			    CALCULATE(
			        [Chg vs Prior Value],
			        'Economic Data'[Attribute] = "Unemployment Rate"
			    ),
			    3
			)
			VAR UnemploymentUpDown = 
			SWITCH(
			    TRUE(),
			    Unemployment > 0, "increased",
			    Unemployment < 0, "decreased",
			    "remained constant"
			)
			VAR Sentiment = 
			CALCULATE(
			    [Chg vs Prior Value],
			    'Economic Data'[Attribute] = "Consumer Sentiment"
			)
			VAR SentimentUpDown = 
			SWITCH(
			    TRUE(),
			    Sentiment > 0, "increased",
			    Sentiment < 0, "decreased",
			    "remained constant"
			)
			VAR FedRateMovement = 
			SWITCH(
			    TRUE(),
			    FedRate > 0, "The fed funds rate increased " & FedRateForamtted & " to help curb inflation and move closer to the feds 2% target. ",
			    FedRate < 0, "The fed funds rate decreased " & FedRateForamtted & " which will drive down short term interest rates and stimulate economic growth. ",
			    "The fed funds rate remained flat signaling that current policy is about where the fed thinks it needs to be short of new inflation, employment, or economic growth data. "
			)
			VAR Conjunction =
			 IF(
			    UnemploymentUpDown = SentimentUpDown,
			    " also",
			    ""
			 )
			RETURN 
			"Annualized real GDP growth for " & QuarterName & " was " & GDP & GDPUpDown & " from prior quarters growth rate of " & PQGDP & ". The latest headline CPI shows a year over year increase in inflation of " & headlineCPI & ". Core CPI increased " & coreCPI & " meaning that food and energy impacted headline inflation by approximately " & FoodEnergy & " percentage points relative to core inflation. " & FedRateMovement & "The unemployment rate " & UnemploymentUpDown & " vs the prior month while consumer sentiment" & Conjunction & " " & SentimentUpDown & "."
			```
		displayFolder: Labels and Dynamic Titles
		lineageTag: f2c38bff-e1cf-4257-9b41-4002fca22a14

	measure 'Date Range Filter' = ```
			
			VAR SelectedYears = 
			SELECTEDVALUE('Date Range Selector'[Years])
			
			VAR MaxDate = 
			CALCULATE(
			    max('Calendar'[Date]),
			    ALL('Calendar')
			)
			
			VAR StartDate = 
			DATE(
			    YEAR(MaxDate) - SelectedYears,
			    1,
			    1
			)
			
			RETURN
			IF(
			    SELECTEDVALUE('Calendar'[Date]) >= StartDate &&
			    SELECTEDVALUE('Calendar'[Date]) <= MaxDate,
			    1,
			    0
			)
			```
		formatString: 0
		displayFolder: Filters
		lineageTag: c67d1fb2-2a14-4518-8a3f-a20d545a7304

